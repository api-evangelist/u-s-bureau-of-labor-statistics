          "id": "c6065e81-6478-4126-a96c-8a37557405a2",
          "name": "U.S. Bureau of Labor Statistics Get Survey Metadata",
          "request": {
            "name": "U.S. Bureau of Labor Statistics Get Survey Metadata",
            "description": {
              "content": "Retrieve detailed metadata for a specific BLS survey using its abbreviation. Returns survey name, description, and available series information.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "surveys",
                ":surveyId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
