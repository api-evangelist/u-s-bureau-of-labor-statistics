                  "disabled": false,
                  "key": "registrationkey",
                  "value": "<string>",
                  "description": "BLS API registration key."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "surveyId",
                  "description": "(Required) Survey abbreviation (e.g., CPS for Current Population Survey, CES for Current Employment Statistics, AP for Average Price Data)."
