        {
          "id": "c76ee09d-f346-47ee-9006-4fbd69b80d0d",
          "name": "U.S. Bureau of Labor Statistics Get Multiple Series Data",
          "request": {
            "name": "U.S. Bureau of Labor Statistics Get Multiple Series Data",
            "description": {
              "content": "Retrieve time series data for one or more BLS series IDs in a single request. Version 2 supports up to 50 series per request and up to 20 years of data. Version 1 supports up to 25 series and fewer features.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "timeseries",
                "data",
                ""
              ],
              "host": [
                "{{baseUrl}}"
