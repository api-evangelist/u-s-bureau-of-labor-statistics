  "info": {
    "_postman_id": "b2186c88-a406-4daa-a2e2-833d8e2246c3",
    "name": "BLS Public Data Series API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The U.S. Bureau of Labor Statistics (BLS) Public Data API provides programmatic access to published historical time series data covering employment, unemployment, prices, wages, and other labor market indicators. The API returns JSON data and supports both Version 1 (no registration) and Version 2 (requires free registration for higher limits and additional features).\n\nContact Support:\n Name: BLS Developer Support\n Email: webmaster@bls.gov",
      "type": "text/plain"
    }
  }
