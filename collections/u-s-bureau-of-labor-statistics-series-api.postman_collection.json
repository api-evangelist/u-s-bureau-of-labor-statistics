      "id": "edc88fae-7d68-4eea-a9b5-81be53fb597c",
      "name": "Series",
      "description": {
        "content": "Time series data operations for retrieving labor statistics across BLS surveys including employment, CPI, wages, and more.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8c120955-82d9-4a75-8896-6c924b8b2dfd",
          "name": "U.S. Bureau of Labor Statistics Get Single Series Data",
          "request": {
            "name": "U.S. Bureau of Labor Statistics Get Single Series Data",
            "description": {
              "content": "Retrieve time series data for a single BLS series ID. Returns historical data points including year, period, and value. Optional parameters allow filtering by year range and requesting additional metadata.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "timeseries",
                "data",
                ":seriesId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startyear",
                  "value": "<string>",
                  "description": "First year of data to retrieve in YYYY format."
                },
                {
                  "disabled": false,
                  "key": "endyear",
                  "value": "<string>",
                  "description": "Last year of data to retrieve in YYYY format."
                },
                {
                  "disabled": false,
                  "key": "registrationkey",
                  "value": "<string>",
                  "description": "BLS API registration key obtained from data.bls.gov/registrationEngine/. Required for Version 2 features such as catalog, calculations, and annual averages."
                },
                {
                  "disabled": false,
                  "key": "catalog",
                  "value": "<boolean>",
                  "description": "Set to true to include series catalog metadata in the response."
                },
                {
                  "disabled": false,
                  "key": "calculations",
                  "value": "<boolean>",
                  "description": "Set to true to include net and percent change calculations."
                },
                {
                  "disabled": false,
                  "key": "annualaverage",
                  "value": "<boolean>",
                  "description": "Set to true to include annual averages in the response."
                },
                {
                  "disabled": false,
                  "key": "aspects",
                  "value": "<boolean>",
                  "description": "Set to true to include aspects metadata for the series."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "seriesId",
                  "description": "(Required) A single BLS series ID (e.g., LAUCN040010000000005 for local area unemployment, CUUR0000SA0 for CPI All Urban Consumers)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
